@model ChangePasswordVM
@{
    ViewData["PageTitle"] = "Change Password";
}

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}

<section class="auth-layout">
    <form asp-controller="Manage" asp-action="ChangePassword" method="post" class="surface-form auth-card">
        <div>
            <span class="eyebrow">Security</span>
            <h1 class="section-title">Change Password</h1>
            <p class="section-lead">Update access without leaving the current session.</p>
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div>
            <label asp-for="OldPassword"></label>
            <input asp-for="OldPassword" class="form-control" />
            <span asp-validation-for="OldPassword" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" data-compare-to="#NewPassword" data-compare-message="Passwords do not match." />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="toolbar-row">
            <a asp-controller="Manage" asp-action="Index" class="btn btn-outline-secondary">Back</a>
            <button type="submit" class="btn btn-success">Change password</button>
        </div>
    </form>
</section>
