@model CategoryWithDepthVM[]
@inject IViewLocalizer Localizer

@{
    ViewData["PageTitle"] = Localizer["Categories"];

    int maxDepth = Model.Any() ? Model.Max(c => c.Depth) : 0;
}

@section scripts {
    <partial name="_CategoriesScriptsPartial" />
}

<section class="page-section">
    <div class="page-header">
        <div>
            <span class="eyebrow">Structure</span>
            <h1>@Localizer["Categories"]</h1>
            <p class="page-header__meta">Flat enough for fast edits, grouped enough to keep hierarchy readable.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">@Localizer["Add"]</a>
    </div>

    <div class="surface-table">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        @for (int i = 0; i < maxDepth + 1; i++)
                        {
                            <th class="fit"></th>
                        }
                        <th>@Localizer["Category"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CategoryWithDepthVM item in Model)
                    {
                        <tr data-id="@item.Id">
                            @for (int i = 0; i < item.Depth; i++)
                            {
                                <td>&nbsp;</td>
                            }
                            <td>
                                <input type="text" class="form-control category-colorpicker" data-color="@item.Color" style="background-color: @item.Color;" />
                            </td>
                            @for (int i = 0; i < maxDepth - item.Depth; i++)
                            {
                                <td>&nbsp;</td>
                            }
                            <td>
                                <input type="text" class="form-control category-name" value="@item.Name" />
                            </td>
                            <td>
                                <select class="form-select category-parent" asp-items="@(new SelectList(item.ParentCandidates, nameof(CategoryVM.Id), nameof(CategoryVM.Name), item.ParentId))">
                                    <option selected="selected" value="">@Localizer["[ root category ]"]</option>
                                </select>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-success btn-sm modified-only save-changes">
                                    @Localizer["save changes"]
                                </button>
                                <a asp-action="Delete" asp-controller="Categories" asp-area="" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                    @Localizer["delete"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
