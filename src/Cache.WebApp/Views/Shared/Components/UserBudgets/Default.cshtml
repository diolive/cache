@using DioRed.Cache.Domain.Entities
@using DioRed.Cache.WebApp.Controllers
@model IReadOnlyCollection<DioRed.Cache.Domain.Entities.Budget>
@inject IViewLocalizer Localizer

@{
    const string create = nameof(BudgetsController.Create);
    const string choose = nameof(BudgetsController.Choose);

    string userId = ViewBag.UserId;
}

@switch (Model.Count)
{
    case 0:
        <p class="text-secondary mb-0">@Localizer["There no any budgets in your account but you can to"] <a asp-area="" asp-controller="Budgets" asp-action="@create">@Localizer["create one"]</a>.</p>
        break;

    case 1:
        <p class="text-secondary">@Localizer["Proceed to your {0} budget", Model.First().Name] <a asp-area="" asp-controller="Budgets" asp-action="@choose" asp-route-id="@Model.First().Id">@Localizer["open it"]</a> @Localizer["or"] <a asp-area="" asp-controller="Budgets" asp-action="@create">@Localizer["create a new one"]</a>.</p>
        break;

    default:
        <p class="text-secondary">@Localizer["Choose the budget to work with"] @Localizer["or"] <a asp-area="" asp-controller="Budgets" asp-action="@create">@Localizer["create a new one"]</a>.</p>
        <div class="chip-grid">
            @foreach (Budget budget in Model)
            {
                <a asp-area="" asp-controller="Budgets" asp-action="@choose" asp-route-id="@budget.Id" class="budget-chip @(budget.AuthorId == userId ? "budget-chip--accent" : "")">
                    @budget.Name
                </a>
            }
        </div>
        break;
}
